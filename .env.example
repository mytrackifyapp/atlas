## Resend (Email)
# Create an API key in Resend and paste it here
RESEND_API_KEY=

# Must be a sender you’ve verified in Resend (your domain is mytrackify.com)
# Examples:
# RESEND_FROM="Trackify <hey@mytrackify.com>"
RESEND_FROM="Trackify <hey@mytrackify.com>"

# Where Contact form submissions should be delivered.
# Comma-separated list supported.
RESEND_CONTACT_TO="hey@mytrackify.com"

## Accelerator (optional)
# Where accelerator applications should go (defaults to RESEND_CONTACT_TO)
RESEND_ACCELERATOR_TO="hey@mytrackify.com"

## Welcome emails (optional)
# Display name is "Divine Gabriel (CEO)"; email must be a verified sender.
RESEND_CEO_FROM='Divine Gabriel (CEO) <hey@mytrackify.com>'

## Stablecoin checkout (USDC / USDT)
# Platform fee on fundraise investments (basis points). 250 = 2.5%. Charged to founders, not investors.
FUNDRAISE_PLATFORM_FEE_BPS=250

# Treasury wallet that receives subscription payments (can be the same address on each chain)
CHECKOUT_TREASURY_BASE=
CHECKOUT_TREASURY_POLYGON=
CHECKOUT_TREASURY_ETHEREUM=

# RPC endpoints for reading on-chain transfers (auto payment detection + tx verify).
# If unset, public endpoints are used — fine for testing, but rate-limited in production.
#
# Get free dedicated URLs from Alchemy (recommended): https://dashboard.alchemy.com
#   1. Create an app per network (Base mainnet, Polygon mainnet, Ethereum mainnet)
#   2. Open each app → "API Key" → copy the HTTPS URL, e.g.:
#      https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
#
# Other providers: Infura (https://infura.io), QuickNode (https://quicknode.com),
# Ankr (https://ankr.com/rpc), or chain docs (Base: https://docs.base.org/tools/network-faucets)
#
# CHECKOUT_RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# CHECKOUT_RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# CHECKOUT_RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
